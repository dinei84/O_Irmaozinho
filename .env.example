# Variáveis do frontend (Vite). Copie para `.env` na raiz e preencha com os
# valores reais do projeto Firebase `admoirmaozinho`.
#
# ATENÇÃO: `npm run build` NÃO falha se este arquivo estiver ausente ou
# incompleto — ele embute `undefined` no bundle e o app quebra no boot, em
# produção, com "Variáveis de ambiente do Firebase faltando".
# Ver docs/os/OS_DEPLOY_002_SPRINT0_R08_PAYMENT001.md (pré-flight).
#
# Onde achar: console.firebase.google.com > Configurações do projeto >
# Seus apps > Configuração do SDK.
#
# Este arquivo (.env.example) é versionado; o `.env` NÃO é (está no .gitignore).
# Nunca comite valores reais.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional — só usado pelo Google Analytics do Firebase
VITE_FIREBASE_MEASUREMENT_ID=

# Chave PÚBLICA do Mercado Pago, usada pelo SDK de tokenização de cartão
# (src/hooks/useMercadoPago.js). Pública por natureza — mas o ACCESS TOKEN
# (secreto) NÃO vem aqui: vive no Secret Manager, via
# `firebase functions:secrets:set MERCADOPAGO_ACCESS_TOKEN`.
# Hoje a loja está fora do ar (página de construção), então esta chave só
# volta a ser necessária quando o checkout for reativado.
VITE_MERCADOPAGO_PUBLIC_KEY=
