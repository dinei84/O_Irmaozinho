rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function para verificar se o usuário é admin
    // Verifica se o custom claim 'role' é 'admin'
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.role == 'admin';
    }
    
    // Helper function para verificar se o usuário é o dono do recurso
    function isOwner(userId) {
      return isAuthenticated() && 
             request.auth.uid == userId;
    }
    
    // Helper function para validar estrutura de artigo
    function isValidArticle(data) {
      return data.keys().hasAll(['title', 'body', 'category']) &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 200 &&
             data.body is string &&
             data.body.size() > 0 &&
             data.body.size() <= 50000 &&
             data.category is string &&
             data.category in ['Artigos', 'Crônicas'] &&
             (!('imageUrl' in data) || 
              data.imageUrl == null ||
              data.imageUrl == "" ||
              (data.imageUrl is string && 
               data.imageUrl.size() <= 1000 &&
               data.imageUrl.matches('^https?://.*')));
    }
    
    // Helper function para validar estrutura de produto
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'stock', 'active']) &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 200 &&
             data.price is number &&
             data.price >= 0 &&
             data.price <= 1000000 &&
             data.stock is int &&
             data.stock >= 0 &&
             data.active is bool &&
             (!('imageUrl' in data) || 
              data.imageUrl == null ||
              data.imageUrl == "" ||
              (data.imageUrl is string && 
               data.imageUrl.size() <= 1000 &&
               data.imageUrl.matches('^https?://.*'))) &&
             (!('supplierId' in data) || 
              (data.supplierId is string && 
               data.supplierId.size() > 0 &&
               data.supplierId.size() <= 200)) &&
             (!('supplierName' in data) || 
              (data.supplierName is string && 
               data.supplierName.size() <= 200));
    }
    
    // Helper function para validar estrutura de fornecedor
    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'email', 'type', 'orderMethod', 'commissionRate', 'paymentMethod', 'active']) &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 200 &&
             data.email is string &&
             data.email.size() > 0 &&
             data.email.size() <= 200 &&
             data.type is string &&
             data.type in ['own', 'third_party'] &&
             data.orderMethod is string &&
             data.orderMethod in ['direct_sale', 'email', 'api'] &&
             data.commissionRate is number &&
             data.commissionRate >= 0 &&
             data.commissionRate <= 1 &&
             data.paymentMethod is string &&
             data.paymentMethod in ['none', 'centralized', 'split'] &&
             data.active is bool &&
             (!('phone' in data) || 
              (data.phone is string && 
               data.phone.size() <= 50)) &&
             (!('orderEmail' in data) || 
              (data.orderEmail is string && 
               data.orderEmail.size() <= 200)) &&
             (!('isDefault' in data) || data.isDefault is bool) &&
             // Validações de consistência
             (data.type == 'own' ? data.commissionRate == 0 : true) &&
             (data.type == 'own' ? data.paymentMethod == 'none' : true) &&
             // Se método é email, orderEmail deve estar presente (validação mais relaxada nas regras)
             (data.orderMethod != 'email' || ('orderEmail' in data && data.orderEmail is string));
    }
    
    // ==========================================
    // REGRAS PARA CONTEÚDO (ARTIGOS/CRÔNICAS)
    // ==========================================
    // Helper function para validar incremento/decremento de likesCount
    // Nota: FieldValue.increment() é resolvido pelo Firestore antes das regras
    // Validamos apenas que apenas likesCount e updatedAt foram alterados
    function isValidLikesCountUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let currentLikes = resource.data.get('likesCount', 0);
      let newLikes = request.resource.data.likesCount;
      
      return affectedKeys.hasOnly(['likesCount', 'updatedAt']) &&
             request.resource.data.likesCount is number &&
             request.resource.data.likesCount >= 0 &&
             // Permite incremento ou decremento de 1 (pode variar em transações concorrentes)
             (newLikes == currentLikes + 1 || newLikes == currentLikes - 1);
    }
    
    // Helper function para validar incremento de commentsCount
    function isValidCommentsCountUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let currentComments = resource.data.get('commentsCount', 0);
      let newComments = request.resource.data.commentsCount;
      
      return affectedKeys.hasOnly(['commentsCount', 'updatedAt']) &&
             request.resource.data.commentsCount is number &&
             request.resource.data.commentsCount >= 0 &&
             // Permite incremento ou decremento de 1
             (newComments == currentComments + 1 || newComments == currentComments - 1);
    }
    
    match /content/{contentId} {
      // Qualquer um (autenticado ou não) pode ler conteúdo
      // Isso permite que visitantes vejam os artigos públicos
      allow read: if true;
      
      // Apenas admins podem criar conteúdo.
      // O corpo do artigo é renderizado como HTML: permitir criação por usuário
      // comum equivale a permitir XSS armazenado (V-04). Não relaxe esta regra.
      allow create: if isAdmin() &&
                       isValidArticle(request.resource.data) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      
      // Admins podem atualizar artigos completos
      // Usuários autenticados podem incrementar/decrementar likesCount ou incrementar commentsCount
      allow update: if (isAdmin() && 
                       isValidArticle(request.resource.data) &&
                       request.resource.data.updatedAt == request.time) ||
                      (isAuthenticated() && (isValidLikesCountUpdate() || isValidCommentsCountUpdate()));
      
      // Apenas admins podem deletar artigos
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // REGRAS PARA PRODUTOS
    // ==========================================
    match /products/{productId} {
      // Qualquer um pode ler produtos ativos
      // Para produtos inativos, apenas admins podem ver
      allow read: if resource.data.active == true || isAdmin();
      
      // Apenas admins podem criar produtos
      allow create: if isAdmin() && 
                       isValidProduct(request.resource.data) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      
      // Apenas admins podem atualizar produtos
      allow update: if isAdmin() && 
                       isValidProduct(request.resource.data) &&
                       request.resource.data.updatedAt == request.time;
      
      // Apenas admins podem deletar produtos
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // REGRAS PARA FORNECEDORES
    // ==========================================
    match /suppliers/{supplierId} {
      // Qualquer um autenticado pode ler fornecedores ativos (para seleção em produtos)
      // Admins podem ler todos
      // Permite ler fornecedor padrão especificamente (mesmo que inativo)
      allow read: if isAuthenticated() && 
                     (resource.data.active == true || 
                      isAdmin() || 
                      resource.data.isDefault == true);
      
      // Apenas admins podem criar fornecedores
      // Permite criar fornecedor padrão se for admin
      allow create: if isAdmin() && 
                       isValidSupplier(request.resource.data) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      
      // Apenas admins podem atualizar fornecedores
      allow update: if isAdmin() && 
                       isValidSupplier(request.resource.data) &&
                       request.resource.data.updatedAt == request.time;
      
      // Apenas admins podem deletar fornecedores (soft delete via update)
      allow delete: if isAdmin();
      
      // Permitir queries na coleção suppliers
      // Usuários autenticados podem fazer queries de fornecedores ativos
      // Admins podem fazer qualquer query
      allow list: if isAuthenticated();
    }
    
    // Helper function para validar estrutura de pedido
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'subtotal', 'finalTotal', 'customer', 'shippingAddress', 'payment', 'orderStatus']) &&
             data.userId is string &&
             data.items is list &&
             data.items.size() > 0 &&
             data.subtotal is number &&
             data.subtotal >= 0 &&
             data.finalTotal is number &&
             data.finalTotal >= 0 &&
             data.customer is map &&
             data.customer.keys().hasAll(['name', 'email']) &&
             data.customer.name is string &&
             data.customer.name.size() > 0 &&
             data.customer.email is string &&
             data.shippingAddress is map &&
             data.shippingAddress.keys().hasAll(['street', 'city', 'state', 'zipCode']) &&
             data.payment is map &&
             data.payment.keys().hasAll(['method', 'status', 'gateway']) &&
             data.orderStatus is string &&
             data.orderStatus in ['pending', 'paid', 'processing', 'shipped', 'delivered', 'cancelled'];
    }
    
    // Helper function para verificar se usuário pode cancelar próprio pedido
    function canCancelOrder(order) {
      return order.orderStatus in ['pending', 'paid'];
    }
    
    // ==========================================
    // REGRAS PARA PEDIDOS
    // ==========================================
    match /orders/{orderId} {
      // Usuários podem ler apenas seus próprios pedidos
      // Admins podem ler todos
      allow read: if isAuthenticated() &&
                    (isOwner(resource.data.userId) || isAdmin());
      
      // Usuários autenticados podem criar pedidos para si mesmos
      // Validar estrutura e dados
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidOrder(request.resource.data) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.orderStatus == 'pending' &&
                       request.resource.data.payment.status == 'pending';
      
      // Atualização de pedidos:
      // - Admins podem atualizar qualquer campo
      // - Usuário pode APENAS cancelar o próprio pedido (pending/paid)
      //
      // Webhooks e Cloud Functions NÃO precisam de regra aqui: usam o Admin SDK,
      // que ignora as Security Rules. Não adicione uma cláusula "para o sistema"
      // — foi exatamente isso que abriu a V-03 (qualquer autenticado escrevendo
      // em qualquer pedido). Ver docs/seguranca/AUDITORIA_SEGURANCA.md
      allow update: if isAdmin() ||
                     (isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      canCancelOrder(resource.data) &&
                      request.resource.data.orderStatus == 'cancelled' &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['orderStatus', 'updatedAt', 'statusHistory']));
      
      // Deleção: apenas admins (recomenda-se soft delete via update)
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // REGRAS PARA LOGS DE AUDITORIA
    // ==========================================
    match /audit_logs/{logId} {
      // Apenas admins podem ler logs
      allow read: if isAdmin();
      
      // Apenas o sistema (via Cloud Functions) pode criar logs
      // No cliente, apenas admins autenticados podem criar logs de suas ações
      allow create: if isAdmin() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.timestamp == request.time;
      
      // Ninguém pode atualizar ou deletar logs (imutável)
      allow update, delete: if false;
    }
    
    // ==========================================
    // REGRAS PARA ADMINS (coleção de controle)
    // ==========================================
    match /admins/{adminId} {
      // Apenas admins podem ler a lista de admins
      allow read: if isAdmin();
      
      // Ninguém pode criar/editar/deletar via cliente
      // Isso deve ser feito via Cloud Functions ou console do Firebase
      allow create, update, delete: if false;
    }
    
    // ==========================================
    // REGRAS PARA CURTIDAS (LIKES)
    // ==========================================
    match /likes/{likeId} {
      // Qualquer um pode ler curtidas (público)
      allow read: if true;
      
      // Validar formato do ID (deve ser contentId_userId)
      function isValidLikeId() {
        return likeId.matches('^[a-zA-Z0-9_-]+_[a-zA-Z0-9_-]+$');
      }
      
      // Usuários autenticados podem criar curtidas
      // Validar que o userId no documento corresponde ao usuário logado
      // Validar que o ID do documento segue o padrão contentId_userId
      allow create: if isAuthenticated() &&
                       isValidLikeId() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.contentId is string &&
                       request.resource.data.contentId.size() > 0 &&
                       request.resource.data.createdAt == request.time &&
                       (!exists(/databases/$(database)/documents/likes/$(likeId)));
      
      // Usuários podem deletar apenas suas próprias curtidas
      // Validar que o userId no documento corresponde ao usuário logado
      allow delete: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid;
      
      // Não permitir atualizações (imutável)
      allow update: if false;
    }
    
    // ==========================================
    // REGRAS PARA COMENTÁRIOS
    // ==========================================
    match /comments/{commentId} {
      // Qualquer um pode ler comentários (público)
      allow read: if true;
      
      // Nome que o autor é OBRIGADO a usar: o `name` do token (displayName do Auth)
      // ou, quando não houver, o prefixo do e-mail autenticado.
      // Sem isso, o userName vem do cliente e qualquer um assina como "Administrador" (V-08).
      function expectedUserName() {
        return ('name' in request.auth.token && request.auth.token.name != '')
               ? request.auth.token.name
               : request.auth.token.email.split('@')[0];
      }

      // Helper function para validar estrutura de comentário
      function isValidComment(data) {
        return data.articleId is string &&
               data.articleId.size() > 0 &&
               data.userId is string &&
               data.userName is string &&
               data.userName == expectedUserName() &&
               data.content is string &&
               data.content.size() >= 3 &&
               data.content.size() <= 500 &&
               data.isDeleted is bool &&
               (!('parentId' in data) || data.parentId == null || data.parentId is string);
      }
      
      // Usuários autenticados podem criar comentários
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidComment(request.resource.data) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      
      // Edição: apenas o dono, apenas o texto, apenas dentro de 1h (+5min de tolerância).
      // O hasOnly() é essencial: sem ele o dono pode reescrever userName, articleId
      // ou createdAt do próprio comentário (V-08).
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       resource.data.isDeleted == false &&
                       request.resource.data.isDeleted == false &&
                       request.resource.data.content is string &&
                       request.resource.data.content.size() >= 3 &&
                       request.resource.data.content.size() <= 500 &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['content', 'updatedAt']) &&
                       // Janela de edição: 1h + 5min de tolerância.
                       // Usar toMillis(): em rules, timestamp.seconds() é o segundo do
                       // minuto (0-59), não a época — comparar `.seconds` faz a regra
                       // falhar sempre e negar toda edição (foi o que levou a versão
                       // original a ser "desativada temporariamente para debug").
                       (request.time.toMillis() - resource.data.createdAt.toMillis()) <= 3900000;
      
      // Usuários podem fazer soft delete apenas de seus próprios comentários
      // Admins podem deletar qualquer comentário
      allow update: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin()) &&
                       request.resource.data.isDeleted == true &&
                       request.resource.data.content == '[Comentário removido]' &&
                       request.resource.data.updatedAt == request.time &&
                       // Validar que apenas content, isDeleted e updatedAt foram alterados
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['content', 'isDeleted', 'updatedAt']);
      
      // Não permitir delete físico (apenas soft delete)
      allow delete: if false;
    }
    
    // ==========================================
    // REGRAS PARA USUÁRIOS (perfis)
    // ==========================================
    match /users/{userId} {
      // Usuários podem ler apenas seu próprio perfil
      // Admins podem ler todos
      allow read: if isOwner(userId) || isAdmin();
      
      // Usuários podem criar apenas seu próprio perfil durante o cadastro
      // Admins podem criar qualquer perfil
      allow create: if (isOwner(userId) || isAdmin()) &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() > 0 &&
                       request.resource.data.role == 'user' && // Sempre user por padrão
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time;
      
      // Usuários podem atualizar apenas seu próprio perfil
      // Admins podem atualizar qualquer perfil
      // Usuários comuns não podem mudar o role (apenas admin via script/Cloud Function)
      allow update: if (isOwner(userId) || isAdmin()) &&
                       (isAdmin() || request.resource.data.role == resource.data.role) &&
                       request.resource.data.updatedAt == request.time;
      
      // Apenas admins podem deletar perfis
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // REGRAS PADRÃO (negar acesso ao resto)
    // ==========================================
    match /{document=**} {
      // Negar acesso a qualquer coleção não especificada acima
      allow read, write: if false;
    }
  }
}

